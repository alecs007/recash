# ─── Required ─────────────────────────────────────────────────────────────────

# MongoDB connection string (Prisma `mongodb` provider).
RECASH_DATABASE_URI="mongodb://localhost:27017/recash"

# Redis, used for caching, rate limiting, WebSocket pub/sub and WS session tokens.
REDIS_URL="redis://localhost:6379"

# NextAuth session secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# REST API version prefix (the app serves /api/v1/...).
NEXT_PUBLIC_API_VERSION="v1"

# Public base URLs. NEXT_PUBLIC_WS_URL must match the port ws-server listens on
# (4001 by default — see WS_PORT below).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:4001"

# ─── OAuth providers (needed for sign-in) ─────────────────────────────────────

# Add http://localhost:3000 as an authorized redirect URI in each provider's console.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# Google One Tap. Usually the same value as AUTH_GOOGLE_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Canonical URL NextAuth builds callbacks from. Only needed when the app is not
# reachable at NEXT_PUBLIC_APP_URL (e.g. behind a proxy or a preview deploy).
# AUTH_URL="http://localhost:3000"

# ─── Optional integrations ────────────────────────────────────────────────────
# Every one of these degrades gracefully when unset; the rest of the app works.

# AI bottle-count estimation from a photo, and the default in-app assistant backend.
GEMINI_API_KEY=""

# In-app chat assistant via Claude. Without a key the endpoint returns a handled 503.
ANTHROPIC_API_KEY=""

# Force which backend serves the assistant: "gemini" or "claude". When unset,
# Gemini is used if GEMINI_API_KEY is present, otherwise Claude.
# ASSISTANT_PROVIDER=""

# Transactional email (radar alerts, notifications). Unset → sending is skipped
# and logged to the console instead.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Recash <noreply@example.com>"

# ─── Tuning & advanced ────────────────────────────────────────────────────────

# Base URL the standalone MCP server uses to reach the Recash REST API.
# RECASH_API_BASE="http://localhost:3000"

# Port for the standalone WebSocket server (ws-server/). Keep NEXT_PUBLIC_WS_URL
# in sync. Ignored where the platform injects PORT (e.g. Railway).
# WS_PORT="4001"

# Comma-separated origins the WebSocket server accepts. Empty → allow all,
# which is fine for local dev but should be set in production.
# ALLOWED_ORIGIN=""

# RON per EUR, used for currency display.
# NEXT_PUBLIC_RON_PER_EUR="5.07"

# Number of trusted reverse-proxy hops when deriving the client IP for rate
# limiting. Raise this only if the app sits behind more than one proxy.
# TRUSTED_PROXY_HOPS="1"

# Set to "1" to swap Redis for an in-process mock. Test/CI only — never production.
# REDIS_MOCK=""
