generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("RECASH_DATABASE_URI")
}


enum UserRole {
  POSTER      // Only posts bottles
  COLLECTOR   // Only collects bottles
  BOTH        // Default — can do both
  ADMIN
}

enum PostStatus {
  OPEN        // Waiting for a collector
  CLAIMED     // A collector accepted
  IN_PROGRESS // Collector is on their way
  COMPLETED   // Exchange done
  CANCELLED   // Poster or collector cancelled
  EXPIRED     // Auto-expired after deadline
}

enum BadgeType {
  // Posting badges
  FIRST_POST
  POST_VETERAN_10
  POST_VETERAN_50
  POST_VETERAN_100

  // Collection badges
  FIRST_COLLECTION
  COLLECTOR_STARTER_10
  COLLECTOR_PRO_50
  COLLECTOR_ELITE_100

  // Volume badges (bottles total)
  ECO_STARTER     // 50 bottles total
  ECO_WARRIOR     // 250 bottles total
  ECO_CHAMPION    // 1000 bottles total
  ECO_LEGEND      // 5000 bottles total

  // Speed badges
  SPEED_DEMON     // Claimed & completed in < 30min

  // Loyalty badges
  FIRST_WEEK
  MONTHLY_ACTIVE
  VETERAN_1_YEAR

  // Transaction badges
  CENTURION       // 100 transactions
  PERFECT_RATING  // 10 transactions with 5/5 avg
}

enum NotificationType {
  POST_CLAIMED
  POST_COMPLETED
  POST_CANCELLED
  POST_EXPIRED
  COLLECTOR_ARRIVED
  BADGE_EARNED
  RATING_RECEIVED
  SYSTEM
}

// ─────────────────────────────────────────────
// NextAuth required models
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// Core models
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(BOTH)
  bio           String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Aggregate stats (denormalized for fast reads)
  totalBottlesGiven     Int   @default(0) // bottles given to collectors
  totalBottlesCollected Int   @default(0) // bottles collected from posters
  totalTransactions     Int   @default(0)
  totalEarned           Float @default(0) // as collector (RON)
  totalSaved            Float @default(0) // as poster: value they received
  reputationScore       Float @default(5.0) // avg of all ratings received
  ratingCount           Int   @default(0)

  // Relations
  accounts     Account[]
  sessions     Session[]
  badges       Badge[]
  posts        Post[]         @relation("PostAuthor")
  claimedPosts Post[]         @relation("PostCollector")
  posterTransactions    Transaction[] @relation("PosterTransactions")
  collectorTransactions Transaction[] @relation("CollectorTransactions")
  notifications         Notification[]
}

model Post {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  authorId    String     @db.ObjectId
  collectorId String?    @db.ObjectId
  status      PostStatus @default(OPEN)

  // Content
  description           String
  bottleCount           Int
  estimatedValue        Float   // poster's estimate of total machine value (RON)
  collectorSharePercent Int     // % that goes to collector, e.g. 70 → collector gets 70%
  images                String[] // URLs of bottle photos

  // Location (exact coordinates)
  latitude     Float
  longitude    Float
  locationName String? // human-readable name e.g. "Str. Avram Iancu, Oradea"
  address      String?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  claimedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime? // optional deadline set by poster

  // Relations
  author      User         @relation("PostAuthor", fields: [authorId], references: [id])
  collector   User?        @relation("PostCollector", fields: [collectorId], references: [id])
  transaction Transaction?
}

model Transaction {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  postId      String @unique @db.ObjectId
  posterId    String @db.ObjectId
  collectorId String @db.ObjectId

  // Financial breakdown
  bottleCount      Int
  actualValue      Float // actual value from recycling machine (RON)
  collectorEarning Float // what collector earns
  posterEarning    Float // what poster gets back

  // Ratings (set after completion)
  collectorRating Int?    // 1–5, given by poster
  posterRating    Int?    // 1–5, given by collector
  collectorReview String?
  posterReview    String?
  posterRatedAt   DateTime?
  collectorRatedAt DateTime?

  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  post      Post @relation(fields: [postId], references: [id])
  poster    User @relation("PosterTransactions", fields: [posterId], references: [id])
  collector User @relation("CollectorTransactions", fields: [collectorId], references: [id])
}

model Badge {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  userId   String    @db.ObjectId
  type     BadgeType
  earnedAt DateTime  @default(now())
  seen     Boolean   @default(false) // for "new badge" notification

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type]) // can't earn same badge twice
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?          // optional deep-link e.g. /profil/tranzactii/xyz
  metadata  Json?            // flexible extra data (postId, badgeType, etc.)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}