generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "mongodb"
  url      = env("RECASH_DATABASE_URI")
}



enum UserRole {
  POSTER
  COLLECTOR
  BOTH
  ADMIN
}

enum PostStatus {
  OPEN
  CLAIMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum BadgeType {
  FIRST_POST
  POST_VETERAN_10
  POST_VETERAN_50
  POST_VETERAN_100
  FIRST_COLLECTION
  COLLECTOR_STARTER_10
  COLLECTOR_PRO_50
  COLLECTOR_ELITE_100
  ECO_STARTER
  ECO_WARRIOR
  ECO_CHAMPION
  ECO_LEGEND
  SPEED_DEMON
  FIRST_WEEK
  MONTHLY_ACTIVE
  VETERAN_1_YEAR
  CENTURION
  PERFECT_RATING
}

enum NotificationType {
  POST_CLAIMED
  POST_COMPLETED
  POST_CANCELLED
  POST_EXPIRED
  COLLECTOR_ARRIVED
  BADGE_EARNED
  RATING_RECEIVED
  SYSTEM
}

// ─── NextAuth models ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  // Needed when looking up all accounts for a user (e.g. during sign-out / account linking)
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Needed when cleaning up expired sessions per user
  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core models ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(BOTH)
  bio           String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  totalBottlesGiven     Int   @default(0)
  totalBottlesCollected Int   @default(0)
  totalTransactions     Int   @default(0)
  totalEarned           Float @default(0)
  totalSaved            Float @default(0)
  reputationScore       Float @default(0.0)
  ratingCount           Int   @default(0)

  accounts              Account[]
  sessions              Session[]
  badges                Badge[]
  posts                 Post[]         @relation("PostAuthor")
  claimedPosts          Post[]         @relation("PostCollector")
  posterTransactions    Transaction[]  @relation("PosterTransactions")
  collectorTransactions Transaction[]  @relation("CollectorTransactions")
  notifications         Notification[]

  // reputationScore is queried for leaderboards / public profiles
  @@index([reputationScore(sort: Desc)])
}

model Post {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  authorId    String     @db.ObjectId
  collectorId String?    @db.ObjectId
  status      PostStatus @default(OPEN)

  description           String
  bottleCount           Int
  estimatedValue        Float
  collectorSharePercent Int
  images                String[]

  latitude     Float
  longitude    Float
  locationName String?
  address      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  claimedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime?

  author      User         @relation("PostAuthor",    fields: [authorId],    references: [id])
  collector   User?        @relation("PostCollector", fields: [collectorId], references: [id])
  transaction Transaction?

  // ── Indexes ────────────────────────────────────────────────────────────────

  // Profile "my posts" page — filter by author, sort by date
  @@index([authorId, createdAt(sort: Desc)])

  // Profile "my posts" filtered by status (e.g. active = OPEN/CLAIMED/IN_PROGRESS)
  @@index([authorId, status])

  // Public feed — open posts sorted by newest; also supports status-only filters
  @@index([status, createdAt(sort: Desc)])

  // Collector view — posts claimed by a specific collector
  @@index([collectorId, status])

  // Expiry background job — finds posts where expiresAt has passed
  @@index([expiresAt])

  // Geo queries — finding posts near a location (lat/lng range scan)
  @@index([latitude, longitude])
}

model Transaction {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  postId      String @unique @db.ObjectId   // unique → implicit index
  posterId    String @db.ObjectId
  collectorId String @db.ObjectId

  bottleCount      Int
  actualValue      Float
  collectorEarning Float
  posterEarning    Float

  collectorRating   Int?
  posterRating      Int?
  collectorReview   String?
  posterReview      String?
  posterRatedAt     DateTime?
  collectorRatedAt  DateTime?

  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  post      Post @relation(fields: [postId],      references: [id])
  poster    User @relation("PosterTransactions",    fields: [posterId],    references: [id])
  collector User @relation("CollectorTransactions", fields: [collectorId], references: [id])

  // ── Indexes ────────────────────────────────────────────────────────────────

  // Profile transactions — poster side, sorted by date (the most common query)
  @@index([posterId, completedAt(sort: Desc)])

  // Profile transactions — collector side, sorted by date
  @@index([collectorId, completedAt(sort: Desc)])

  // The OR query (posterId OR collectorId) hits both indexes above via index union.
  // No additional compound needed.

  // Pending ratings — find transactions where the poster hasn't rated yet
  @@index([posterId, posterRating])

  // Pending ratings — find transactions where the collector hasn't rated yet
  @@index([collectorId, collectorRating])
}

model Badge {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  userId   String    @db.ObjectId
  type     BadgeType
  earnedAt DateTime  @default(now())
  seen     Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])   // unique → also serves as index for userId lookups
  // Sort by date for the profile badges feed
  @@index([userId, earnedAt(sort: Desc)])
  // Efficiently find unseen badges for the "new badge" notification dot
  @@index([userId, seen])
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Indexes ────────────────────────────────────────────────────────────────

  // Main notifications feed — by user, newest first
  @@index([userId, createdAt(sort: Desc)])

  // Unread count query and "mark all read" update
  @@index([userId, read])

  // Combined: unread notifications for a user sorted by date
  // (covers the ?unread=true query efficiently)
  @@index([userId, read, createdAt(sort: Desc)])
}
